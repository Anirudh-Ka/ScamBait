# Copy to .env and fill in. Every key is optional: without one, that feature
# falls back to an offline version and the game still works.

# Google Gemini: writes the scams, plays the scammer in chat, writes the debrief.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Comma-separated, tried in order.
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-flash-latest

# ElevenLabs: voices for the phone call, voicemail and read-aloud.
# Get a key at https://elevenlabs.io (Profile > API keys). It needs the Text to Speech permission.
ELEVENLABS_API_KEY=
# Optional. Comma-separated, tried in order. eleven_v4 and eleven_v3 follow emotion
# tags ([panicked], [whispers]); the others are fallbacks.
# ELEVENLABS_MODEL=eleven_v4,eleven_v3,eleven_multilingual_v2,eleven_flash_v2_5
# Optional voice overrides, one per kind of caller. Run "npm run voices" to hear the
# defaults, then paste any voice ID from the ElevenLabs voice library.
# ELEVENLABS_VOICE_YOUNG_MALE=bIHbv24MWmeRgasZH58o     # Will: grandson, brother
# ELEVENLABS_VOICE_YOUNG_FEMALE=cgSgspJ2msm6clMCkdW9   # Jessica: daughter
# ELEVENLABS_VOICE_ADULT_MALE=cjVigY5qzO86Huf0OWal     # Eric: fake bank officer, lawyer
# ELEVENLABS_VOICE_ADULT_FEMALE=EXAVITQu4vr4xnSDxMaL   # Sarah
# ELEVENLABS_VOICE_OLDER_MALE=pqHfZKP75CvOlQylNhV4     # Bill
# ELEVENLABS_VOICE_OLDER_FEMALE=XrExE9yKIg1WjnnlVkGX   # Matilda
# ELEVENLABS_VOICE_NARRATOR=XrExE9yKIg1WjnnlVkGX       # Matilda: reads messages aloud

# Capital One Nessie: gives each player a real sandbox checking account.
# Sign in with GitHub at the Nessie site and copy the key from your profile.
NESSIE_API_KEY=
# Optional. Comma-separated, probed in order.
# NESSIE_BASE_URL=https://prod-api.nessieisreal.com,http://api.nessieisreal.com

PORT=8787
