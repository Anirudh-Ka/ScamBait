{
  "name": "scambait",
  "version": "1.0.0",
  "private": true,
  "description": "ScamBait: an AI scam simulator that tries to scam you on purpose, so real scammers can't.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node --watch server/index.js\" \"vite\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "check": "node scripts/smoke.js",
    "build:demo": "vite build --config vite.demo.config.js",
    "doctor": "node scripts/doctor.js",
    "voices": "node scripts/doctor.js --voices",
    "render-voices": "node scripts/render-voices.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "lucide-react": "^1.59.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
